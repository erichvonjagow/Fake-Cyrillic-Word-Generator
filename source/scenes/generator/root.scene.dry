= Fake Cyrillic Word Generator

@start_menu
title: Back to start
on-arrival {!
    Q.wip_var = 0
!}

- @rus1: Go to the Russian Cyrillic Word Generator
- @ukr1: Go to the Ukrainian Cyrillic Word Generator
- @bel1: Go to the Belorussian Cyrillic Word Generator

@rus1
new-page: true

- @rus_1L: Generate a one letter word

@rus_1L
new-page: true
on-arrival: {!
    Q.wip_var = 1
    let L1 = Math.floor(Math.random() * 33) + 1;
    if (L1 === 1) {
        Q.RL1 = "Щ";
    }
    else if (L1 === 2) {
        Q.RL1 = "0";
    }
    else {
        Q.RL1 = "5";
    }
    Q.result = "[+ RL1 +]";
!}
go-to: result

@ukr1
new-page: true
choose-if: never
unavailable-subtitle: Unavailable - Work in progress

